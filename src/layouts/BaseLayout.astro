---
import '../styles/global.css';
import { homePath, locales, messages, type Locale } from '../i18n';
interface Props {
  locale: Locale;
  title: string;
  description: string;
}
const { locale, title, description } = Astro.props;
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : undefined;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    {Astro.site &&
      locales.map((language) => (
        <link
          rel="alternate"
          hreflang={language}
          href={new URL(homePath(language), Astro.site)}
        />
      ))}
    {Astro.site && (
      <link
        rel="alternate"
        hreflang="x-default"
        href={new URL(homePath('es'), Astro.site)}
      />
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">
      {messages[locale].skip}
    </a>
    <slot />
  </body>
</html>
