---
import BaseLayout from '../layouts/BaseLayout.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import HeroSection from './HeroSection.astro';
import ProjectsSection from './ProjectsSection.astro';
import AboutSection from './AboutSection.astro';
import TechnologiesSection from './TechnologiesSection.astro';
import ExperienceSection from './ExperienceSection.astro';
import cv from '../../personal/Cv_Juan_Sebastian_Martinez_Uribe.pdf?url';
import { messages, profile, type Locale } from '../i18n';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props,
  t = messages[locale];
const links = [
  [t.projectsId, t.sections.projects],
  [t.about.id, t.sections.about],
  [t.technologies.id, t.sections.stack],
  [t.experienceId, t.sections.experience],
  [t.contactId, t.sections.contact],
];
---

<BaseLayout
  {locale}
  title={profile.name + ' | ' + t.role}
  description={t.description}
>
  <div class="page-shell">
    <header class="site-header">
      <span class="wordmark" aria-hidden="true">
        JSM<span>.</span>
      </span>
      <LanguageSwitcher {locale} />
      <nav class="section-nav" aria-label={t.navigation}>
        <ul role="list">
          {links.map(([id, label]) => (
            <li>
              <a href={'#' + id}>{label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </header>
    <main id="main" tabindex="-1">
      <HeroSection {locale} />
      <ProjectsSection {locale} />
      <AboutSection {locale} />
      <TechnologiesSection {locale} />
      <ExperienceSection {locale} />
    </main>
  </div>
  <footer class="contact" id={t.contactId} tabindex="-1">
    <div class="page-container">
      <h2 class="eyebrow">{t.sections.contact}</h2>
      <p>{t.contactLine}</p>
      <a class="email" href={'mailto:' + profile.email}>
        {profile.email}
      </a>
      <div class="actions">
        <a href={profile.github}>GitHub ↗</a>
        <a href={profile.linkedin}>LinkedIn ↗</a>
        <a href={cv} download="Cv_Juan_Sebastian_Martinez_Uribe.pdf">
          CV (PDF)
        </a>
      </div>
    </div>
  </footer>
</BaseLayout>
<script>
  import { installMotion } from '../utils/motion';
  installMotion();
</script>
<style>
  .contact {
    background: var(--accent);
    padding-block: clamp(2.75rem, 6vw, 5rem);
  }
  .contact p {
    max-width: 27ch;
    font-size: clamp(1.8rem, 3.5vw, 3.1rem);
    font-weight: 630;
    line-height: 1.13;
    letter-spacing: -0.045em;
    margin: 0.8rem 0 1.2rem;
  }
  .email {
    font-size: clamp(1.1rem, 2vw, 1.55rem);
  }
  .contact .actions {
    margin-top: 1.25rem;
  }
</style>
