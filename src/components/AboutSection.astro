---
import { messages, type Locale } from '../i18n';
interface Props {
  locale: Locale;
}
const t = messages[Astro.props.locale];
---

<section
  class="home-section editorial"
  id={t.about.id}
  aria-labelledby="about-title"
  tabindex="-1"
>
  <h2 class="section-title" id="about-title">
    {t.sections.about}
  </h2>
  <div>
    {t.about.paragraphs.map((p) => (
      <p>{p}</p>
    ))}
  </div>
</section>
<style>
  p {
    color: var(--text-muted);
    max-width: 60ch;
    font-size: 1.1rem;
  }
  p + p {
    margin-top: 1rem;
  }
</style>
