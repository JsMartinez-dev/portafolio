---
import { homePath, projectPath, locales, messages, type Locale } from '../i18n';
interface Props {
  locale: Locale;
  projectId?: string;
}
const { locale, projectId } = Astro.props;
---

<nav aria-label={messages[locale].language}>
  <ul class="language-list">
    {locales.map((language) => (
      <li>
        <a
          href={
            projectId ? projectPath(language, projectId) : homePath(language)
          }
          lang={language}
          hreflang={language}
          aria-label={language === 'es' ? 'Español' : 'English'}
          aria-current={language === locale ? 'page' : undefined}
        >
          {language.toUpperCase()}
        </a>
      </li>
    ))}
  </ul>
</nav>
