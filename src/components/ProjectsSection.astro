---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import ProjectModal from './ProjectModal.astro';
import TechnologyList from './TechnologyList.astro';
import { messages, projectPath, type Locale } from '../i18n';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props,
  t = messages[locale];
const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<section
  class="home-section"
  id={t.projectsId}
  aria-labelledby="projects-title"
  tabindex="-1"
>
  <h2 class="section-title" id="projects-title">
    {t.sections.projects}
  </h2>
  {projects.map((project) => (
    <article class="feature">
      <Image
        src={project.data.cover}
        alt=""
        widths={[360, 600, 960, 1280]}
        sizes="(min-width: 52rem) 52vw, 92vw"
        loading="lazy"
      />
      <div>
        <p class="eyebrow">{project.data[locale].category}</p>
        <h3>{project.data.title}</h3>
        <p class="summary">{project.data[locale].summary}</p>
        <TechnologyList names={project.data.featured} />
        <div class="actions">
          <a
            class="button primary"
            href={projectPath(locale, project.id)}
            aria-haspopup="dialog"
            aria-controls={'detail-' + project.id}
          >
            {t.projects.details}
            <span class="sr-only"> · {project.data.title}</span>
          </a>
          <a href={project.data.repository}>{t.projects.repository} ↗</a>
        </div>
      </div>
      <ProjectModal {project} {locale} />
    </article>
  ))}
</section>
<style>
  .feature {
    display: grid;
    align-items: center;
    gap: clamp(1.3rem, 3.5vw, 3rem);
    padding-block: clamp(2rem, 4vw, 3.5rem);
    border-top: 1px solid var(--border-subtle);
  }
  .feature > img {
    width: 100%;
    height: auto;
    border-radius: 0.35rem;
  }
  .feature h3 {
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 680;
    letter-spacing: -0.055em;
    line-height: 1.08;
    margin: 0.45rem 0 1rem;
  }
  .summary {
    color: var(--text-muted);
    margin-bottom: 1.25rem;
  }
  .actions {
    margin-top: 1.6rem;
  }
  @media (min-width: 52rem) {
    .feature {
      grid-template-columns: 1.2fr 1fr;
    }
    .feature:nth-of-type(even) > img {
      grid-column: 2;
      grid-row: 1;
    }
    .feature:nth-of-type(even) > div {
      grid-column: 1;
      grid-row: 1;
    }
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .feature > img {
      transition: transform 0.22s;
    }
    .feature:hover > img {
      transform: translateY(-3px);
    }
  }
</style>
