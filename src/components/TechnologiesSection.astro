---
import TechnologyList from './TechnologyList.astro';
import { skills } from '../data/technologies';
import { messages, type Locale } from '../i18n';
interface Props {
  locale: Locale;
}
const { sections, technologies } = messages[Astro.props.locale];
---

<section
  class="home-section"
  id={technologies.id}
  tabindex="-1"
  aria-labelledby="technologies-title"
>
  <h2 id="technologies-title" class="section-title">
    {sections.stack}
  </h2>
  <div class="skills">
    {skills.map((names, i) => (
      <div>
        <h3>{technologies.groups[i]}</h3>
        <TechnologyList names={names} label={technologies.groups[i]} />
      </div>
    ))}
  </div>
</section>
<style>
  .skills {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: 2rem;
  }
  .skills > div {
    border-block-start: 1px solid var(--border-subtle);
    padding-top: 1rem;
  }
  .skills h3 {
    font-size: 1.13rem;
    font-weight: 650;
    margin-bottom: 1rem;
  }
  .skills > div:first-child {
    border-color: var(--accent-foreground);
  }
</style>
