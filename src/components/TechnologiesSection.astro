---
import azure from '../assets/technologies/azure.svg?url';
import docker from '../assets/technologies/docker.svg?url';
import dynamodb from '../assets/technologies/dynamodb.svg?url';
import fastapi from '../assets/technologies/fastapi.svg?url';
import flyway from '../assets/technologies/flyway.svg?url';
import git from '../assets/technologies/git.svg?url';
import github from '../assets/technologies/github.svg?url';
import githubActions from '../assets/technologies/githubactions.svg?url';
import java from '../assets/technologies/java.svg?url';
import linux from '../assets/technologies/linux.png?url';
import mysql from '../assets/technologies/mysql.svg?url';
import neo4j from '../assets/technologies/neo4j.svg?url';
import postgresql from '../assets/technologies/postgresql.svg?url';
import postman from '../assets/technologies/postman.svg?url';
import powerbi from '../assets/technologies/powerbi.svg?url';
import python from '../assets/technologies/python.svg?url';
import redis from '../assets/technologies/redis.svg?url';
import spring from '../assets/technologies/spring.svg?url';
import swagger from '../assets/technologies/swagger.svg?url';
import { messages, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

type Technology = { name: string; icon: string };

const { locale } = Astro.props;
const { sections, technologies } = messages[locale];
const { groups } = technologies;
const categories: { title: string; items: Technology[] }[] = [
  {
    title: groups.backend,
    items: [
      { name: 'Java', icon: java },
      { name: 'Spring Boot', icon: spring },
      { name: 'Python', icon: python },
      { name: 'FastAPI', icon: fastapi },
    ],
  },
  {
    title: groups.databases,
    items: [
      { name: 'PostgreSQL', icon: postgresql },
      { name: 'DynamoDB', icon: dynamodb },
      { name: 'Redis', icon: redis },
      { name: 'MySQL', icon: mysql },
      { name: 'Neo4j', icon: neo4j },
    ],
  },
  {
    title: groups.devops,
    items: [
      { name: 'Docker', icon: docker },
      { name: 'Git', icon: git },
      { name: 'GitHub', icon: github },
      { name: 'GitHub Actions', icon: githubActions },
      { name: 'Azure', icon: azure },
    ],
  },
  {
    title: groups.otherTools,
    items: [
      { name: 'Flyway', icon: flyway },
      { name: 'Swagger', icon: swagger },
      { name: 'Postman', icon: postman },
      { name: 'Linux', icon: linux },
      { name: 'Power BI', icon: powerbi },
    ],
  },
];
---

<section
  class="home-section"
  id={technologies.id}
  aria-labelledby="technologies-title"
  tabindex="-1"
  data-technologies
>
  <h2 class="section-title" id="technologies-title">
    {sections.stack}
  </h2>
  <div class="technology-grid">
    {categories.map(({ title, items }, index) => (
      <div class="technology-group">
        <h3 id={`technology-group-${index}`}>{title}</h3>
        <ul role="list" aria-labelledby={`technology-group-${index}`}>
          {items.map(({ name, icon }) => (
            <li>
              <img
                src={icon}
                width="20"
                height="20"
                loading="lazy"
                decoding="async"
                alt=""
              />
              <span>{name}</span>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>

<script>
  import { createMotionContext } from '../utils/motion';

  const section = document.querySelector<HTMLElement>('[data-technologies]');
  if (section && window.location.hash !== `#${section.id}`) {
    createMotionContext(section, (gsap) => {
      for (const list of section.querySelectorAll('ul')) {
        gsap.from(list.children, {
          y: 8,
          opacity: 0.86,
          duration: 0.38,
          stagger: 0.06,
          ease: 'power2.out',
          immediateRender: false,
          clearProps: 'transform,opacity',
          scrollTrigger: { trigger: list, start: 'top 92%', once: true },
        });
      }
    })
      .then((motion) => {
        if (motion) {
          window.addEventListener('pagehide', motion.dispose, { once: true });
        }
      })
      .catch(() => {
        // The list stays visible if optional motion cannot load.
      });
  }
</script>

<style>
  .technology-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 23rem), 1fr));
    gap: clamp(1rem, 2.5vw, 1.75rem);
    margin-block-start: clamp(1.5rem, 4vw, 2.75rem);
  }

  .technology-group {
    display: grid;
    align-content: start;
    gap: 1rem;
    padding: clamp(1rem, 3vw, 1.5rem);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-card);
    background: var(--surface-panel);
  }

  h3 {
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
  }

  li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-block-size: 2.5rem;
    max-inline-size: 100%;
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--border-subtle);
    border-radius: 999px;
    background: var(--surface-1);
    color: var(--text-muted);
    font-size: 0.875rem;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  img {
    flex: none;
    inline-size: 1.25rem;
    block-size: 1.25rem;
    object-fit: contain;
  }
</style>
